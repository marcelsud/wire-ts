{
  "name": "wire-typescript",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A Wire-inspired TypeScript protobuf prototype",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelsud/wire-ts.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    }
  },
  "bin": {
    "protoc-gen-wire-ts": "./dist/src/plugin.js"
  },
  "files": ["dist/src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "npm run build && buf generate",
    "check": "tsc --noEmit",
    "test": "npm run generate && npm run check && node --experimental-strip-types --test --test-isolation=none test/*.test.ts",
    "test:wire": "npm run generate && node --experimental-strip-types test/wire-interop.ts",
    "demo": "npm run generate && node --experimental-strip-types examples/demo.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
